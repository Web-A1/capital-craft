{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "tpl_capitalcraft",
  "version": "1.0.0",
  "description": "Web Asset manifest for the Capital Craft site template.",
  "license": "Proprietary",
  "assets": [
    {
      "name": "tpl.capitalcraft.base",
      "type": "style",
      "uri": "css/base.css",
      "version": "auto"
    },
    {
      "name": "tpl.capitalcraft.home",
      "type": "style",
      "uri": "css/home.css",
      "version": "auto",
      "dependencies": [
        "tpl.capitalcraft.base"
      ]
    },
    {
      "name": "tpl.capitalcraft.faq",
      "type": "style",
      "uri": "css/faq.css",
      "version": "auto",
      "dependencies": [
        "tpl.capitalcraft.base"
      ]
    },
    {
      "name": "tpl.capitalcraft.legal",
      "type": "style",
      "uri": "css/legal.css",
      "version": "auto",
      "dependencies": [
        "tpl.capitalcraft.base"
      ]
    },
    {
      "name": "tpl.capitalcraft.blog",
      "type": "style",
      "uri": "css/blog.css",
      "version": "auto",
      "dependencies": [
        "tpl.capitalcraft.base"
      ]
    },
    {
      "name": "tpl.capitalcraft.swiper.css",
      "type": "style",
      "uri": "js/vendor/swiper/swiper-bundle.min.css",
      "version": "11.1.3",
      "dependencies": [
        "tpl.capitalcraft.base"
      ]
    },
    {
      "name": "tpl.capitalcraft.bundle",
      "type": "script",
      "uri": "js/global/bundle.js",
      "version": "auto",
      "attributes": {
        "type": "module"
      },
      "options": {
        "position": "after-body"
      }
    },
    {
      "name": "tpl.capitalcraft.swiper",
      "type": "script",
      "uri": "js/vendor/swiper/swiper-bundle.min.js",
      "version": "11.1.3",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      }
    },
    {
      "name": "tpl.capitalcraft.embla",
      "type": "script",
      "uri": "js/vendor/embla/embla-carousel.umd.js",
      "version": "7.1.0",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      }
    },
    {
      "name": "tpl.capitalcraft.embla-autoplay",
      "type": "script",
      "uri": "js/vendor/embla/embla-carousel-autoplay.umd.js",
      "version": "7.1.0",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.embla"
      ]
    },
    {
      "name": "tpl.capitalcraft.home.partners",
      "type": "script",
      "uri": "js/pages/home/partners.js",
      "version": "auto",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.embla-autoplay"
      ]
    },
    {
      "name": "tpl.capitalcraft.home.showcase",
      "type": "script",
      "uri": "js/pages/home/show_case_swiper.js",
      "version": "auto",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.swiper"
      ]
    },
    {
      "name": "tpl.capitalcraft.home.faq",
      "type": "script",
      "uri": "js/pages/home/faq_swiper.js",
      "version": "auto",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.swiper"
      ]
    },
    {
      "name": "tpl.capitalcraft.home.reviews",
      "type": "script",
      "uri": "js/pages/home/reviews_swiper.js",
      "version": "auto",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.swiper"
      ]
    },
    {
      "name": "tpl.capitalcraft.faq-script",
      "type": "script",
      "uri": "js/pages/faq/faq.js",
      "version": "auto",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.bundle"
      ]
    },
    {
      "name": "tpl.capitalcraft.blog.filter",
      "type": "script",
      "uri": "js/pages/blog/filter.js",
      "version": "auto",
      "attributes": {
        "defer": true
      },
      "options": {
        "position": "after-body"
      },
      "dependencies": [
        "tpl.capitalcraft.bundle"
      ]
    }
  ]
}
