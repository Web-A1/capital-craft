{
  "name": "capital-craft",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "less:critical": "lessc -x templates/capitalcraft/less/critical.less templates/capitalcraft/css/critical.css",
    "less:home": "lessc -x templates/capitalcraft/less/home.less templates/capitalcraft/css/home.css",
    "less:faq": "lessc -x templates/capitalcraft/less/faq.less templates/capitalcraft/css/faq.css",
    "less:base": "lessc -x templates/capitalcraft/less/base.less templates/capitalcraft/css/base.css",
    "less:all": "npm-run-all less:base less:critical less:home less:faq",
    "js:build": "esbuild templates/capitalcraft/js/global/script.js --bundle --format=esm --minify --target=es2019 --outfile=templates/capitalcraft/js/global/bundle.js",
    "sitemap": "node scripts/generate-sitemap.js",
    "build": "npm run less:all && npm run js:build && npm run sitemap",
    "watch:all": "./watch-all.sh",
    "push:dev": "git add . && git commit -m \"Update $(date +%Y-%m-%d_%H:%M:%S)\" && git push origin dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:less": "prettier --write \"**/*.less\"",
    "format:less:check": "prettier --check \"**/*.less\"",
    "format:php": "vendor/bin/php-cs-fixer fix",
    "format:php:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
    "format:php:dry": "vendor/bin/php-cs-fixer fix --dry-run"
  },
  "dependencies": {
    "esbuild": "^0.25.9",
    "imask": "^7.6.1",
    "less": "^4.4.1",
    "mcp-pagespeed-server": "github:PhialsBasement/Pagespeed-MCP-Server",
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "prettier": "^3.6.2"
  }
}
