{
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
  "plugins": [
    "@prettier/plugin-php",
    "prettier-plugin-css-order",
    "prettier-plugin-organize-attributes"
  ],
  "cssDeclarationSorterOrder": "alphabetical",
  "htmlWhitespaceSensitivity": "css"
}
